<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.ghyura.cf</groupId>
    <artifactId>cf-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fw-app</artifactId>
  <name>fw-app</name>
  <description>Command line and the single runnable distribution (fw-app.jar).</description>

  <properties>
    <cf.module.name>org.ghyura.cf.app</cf.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-model</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-input</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-plan</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-store</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-generation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-campaign</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-artifacts</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-desktop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-analysis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- the public command is: java -jar fw-app.jar ... -->
    <finalName>fw-app</finalName>
    <resources>
      <!-- only version.properties is filtered (it carries ${project.version}) -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- merge META-INF/services descriptors so every module's providers survive -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Main-Class>org.ghyura.cf.app.Main</Main-Class>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <!-- the project's own terms, unchanged (OPEN-08); the upstream files keep their places under META-INF/licenses/ -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/LICENSE</resource>
                  <file>${project.basedir}/../LICENSE</file>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/NOTICE.md</resource>
                  <file>${project.basedir}/../NOTICE.md</file>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <!-- guif uses FlatLaf's Java UI delegates; optional native decorations/choosers are disabled. -->
                  <artifact>com.formdev:flatlaf</artifact>
                  <excludes>
                    <exclude>com/formdev/flatlaf/natives/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <!-- each upstream jar's license and notice travel unchanged in META-INF/licenses/ARTIFACT/ instead
                         (META-INF/cf-third-party.xml); left here, one jar's file would silently replace another's -->
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/LICENSE.txt</exclude>
                    <exclude>META-INF/NOTICE</exclude>
                    <exclude>META-INF/NOTICE.txt</exclude>
                    <exclude>META-INF/DEPENDENCIES</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- POI's Visio (XDGF) support needs curvesapi, which is excluded; the framework never opens Visio files -->
                  <artifact>org.apache.poi:poi-ooxml</artifact>
                  <excludes>
                    <exclude>org/apache/poi/xdgf/**</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
