{
  "version": 1,
  "constraints": [
    {
      "id": "apply_requires_a_constructed_data_draft",
      "polarity": "require",
      "assert": {
        "any": [
          {
            "not": {
              "sheet": "resolution",
              "eq": "o.put(\"resolution\",\"apply\");"
            }
          },
          {
            "sheet": "selection",
            "present": true
          }
        ]
      }
    }
  ]
}
