<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.ghyura.cf</groupId>
  <artifactId>cf-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Combinatorics Framework JVM</name>
  <description>Single-JVM, database-free Java analog of the Combinatorics Framework (handoff architecture revision 1).</description>

  <!-- Modules are added as their work packages begin (handoff/implementation-plan.xml).
       fw-acceptance is created at M00 because gates A01/A02 are cross-module. -->
  <modules>
    <module>fw-model</module>
    <module>fw-config</module>
    <module>fw-input</module>
    <module>fw-algebra</module>
    <module>fw-constraints</module>
    <module>fw-plan</module>
    <module>fw-store</module>
    <module>fw-generation</module>
    <module>fw-compiler</module>
    <module>fw-results</module>
    <module>fw-execution</module>
    <module>fw-analysis</module>
    <module>fw-sut-fixtures</module>
    <module>fw-python</module>
    <module>fw-campaign</module>
    <module>fw-artifacts</module>
    <module>fw-desktop</module>
    <module>fw-app</module>
    <module>fw-acceptance</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- fixed timestamp: byte-identical jars from identical sources (A20) -->
    <project.build.outputTimestamp>2026-10-01T00:00:00Z</project.build.outputTimestamp>
    <junit.version>6.1.3</junit.version>
    <!-- third-party parsing libraries (D10): exact pins; POI is newer than the legacy Core's 5.4.0 on purpose
         (5.4.0 predates the fix for CVE-2025-31672, duplicate OOXML zip entries) -->
    <jackson.version>2.22.3</jackson.version>
    <poi.version>5.5.1</poi.version>
    <flatlaf.version>3.7.2</flatlaf.version>
    <cf.module.name>org.ghyura.cf</cf.module.name>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.formdev</groupId>
        <artifactId>flatlaf</artifactId>
        <version>${flatlaf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
        <exclusions>
          <!-- curvesapi (BSD-3-Clause, shipped without a license file) serves only POI's Visio geometry
               (org.apache.poi.xdgf); the framework reads and writes spreadsheets only, so it is left out and
               fw-app's shade step drops the Visio classes that would reference it -->
          <exclusion>
            <groupId>com.github.virtuald</groupId>
            <artifactId>curvesapi</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-input</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-generation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-algebra</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-constraints</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-plan</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-store</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-config</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-compiler</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-results</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-execution</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-sut-fixtures</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-python</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-analysis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-campaign</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-artifacts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-desktop</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ghyura.cf</groupId>
        <artifactId>fw-app</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
            <showWarnings>true</showWarnings>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <failIfNoTests>true</failIfNoTests>
            <trimStackTrace>false</trimStackTrace>
            <!-- architect decision R-TEST: XML reports and console only, no plain-text report files -->
            <useFile>false</useFile>
            <useModulePath>false</useModulePath>
            <argLine>-Dfile.encoding=UTF-8 -Djava.awt.headless=true</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <failIfNoTests>true</failIfNoTests>
            <trimStackTrace>false</trimStackTrace>
            <!-- architect decision R-TEST: XML reports and console only, no plain-text report files -->
            <useFile>false</useFile>
            <useModulePath>false</useModulePath>
            <argLine>-Dfile.encoding=UTF-8 -Djava.awt.headless=true</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <archive>
              <manifestEntries>
                <Automatic-Module-Name>${cf.module.name}</Automatic-Module-Name>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
