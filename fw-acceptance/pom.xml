<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.ghyura.cf</groupId>
    <artifactId>cf-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fw-acceptance</artifactId>
  <name>fw-acceptance</name>
  <description>Cross-module acceptance gates and architecture rules. Test-only: nothing depends on it and it is never shipped.</description>

  <properties>
    <cf.module.name>org.ghyura.cf.acceptance</cf.module.name>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!-- every dependency is test scope: this artifact has no production code -->
  <dependencies>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-app</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-model</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-config</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-input</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-plan</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-store</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-constraints</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-generation</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-compiler</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-results</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-execution</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-campaign</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-sut-fixtures</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the Python add-on: in-process runs of original Python through cf.execution.sut=python (author decision 2026-10-12) -->
    <dependency>
      <groupId>org.ghyura.cf</groupId>
      <artifactId>fw-python</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the corpus survey opens the real workbooks directly (from bytes), independent of the framework's own reader -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- the 32 real workbooks live with the input module; they are reused here, not copied -->
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <directory>${project.basedir}/../fw-input/src/test/resources</directory>
        <includes>
          <include>org/ghyura/cf/input/legacy/**</include>
        </includes>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <!-- source and bytecode scans: need the compiled reactor next to this module -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <cf.reactor.root>${project.basedir}/..</cf.reactor.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- the packaged-jar checks (*IT) run after fw-app has been shaded -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <cf.reactor.root>${project.basedir}/..</cf.reactor.root>
            <cf.app.jar>${project.basedir}/../fw-app/target/fw-app.jar</cf.app.jar>
            <cf.fixtures.jar>${project.basedir}/../fw-sut-fixtures/target/fw-sut-fixtures-${project.version}.jar</cf.fixtures.jar>
            <cf.python.jar>${project.basedir}/../fw-python/target/fw-python-${project.version}.jar</cf.python.jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
